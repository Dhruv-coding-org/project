# For local development, this defaults to http://localhost:3001 in the code.
# For production (Vercel deployment), uncomment and set this to your Render URL:
# VITE_SERVER_URL=https://syncstream-server.onrender.com

# WebRTC TURN Server Configuration (Optional, but highly recommended for cross-network WebRTC)
# You can get a free TURN server from Metered Video (metered.ca/stun-turn) or Twilio.
# VITE_TURN_URL=turn:global.turn.twilio.com:3478?transport=udp
# VITE_TURN_USERNAME=your_username
# VITE_TURN_CREDENTIAL=your_credential
